# Marcus configuration. Copy this file to .env and fill in the keys.
#
# Recommended cloud stack (what the product is tuned and tested with):
#   speech in  : Zhipu GLM ASR     (GLM_API_KEY)
#   speech out : MiniMax TTS       (MINIMAX_API_KEY)   ~0.5s per sentence
#   reasoning  : DeepSeek          (DEEPSEEK_API_KEY)
#   web search : Brave Search      (BRAVE_SEARCH_API_KEY, optional)
# Check your setup any time with:  uv run python scripts/doctor.py --live

# --- Recommended stack ---
GLM_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
BRAVE_SEARCH_API_KEY=

# Selectable DeepSeek text models (comma-separated). DeepSeek has TEXT models
# only -- no TTS/ASR counterparts exist.
DEEPSEEK_TEXT_MODELS=deepseek-flash,deepseek-v4-pro

# Which model each role tier uses ("<provider>:<modelId>"). All three default
# to deepseek:deepseek-flash; uncomment to repoint one.
# AGENT_RUNTIME_MODEL_FAST=deepseek:deepseek-flash
# AGENT_RUNTIME_MODEL_BALANCED=deepseek:deepseek-flash
# AGENT_RUNTIME_MODEL_DEEP=deepseek:deepseek-flash

# --- Alternative providers (select them in model_providers.json) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Streaming speech-to-text
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Streaming text-to-speech
CARTESIA_API_KEY=
# Spoken language for Cartesia (default zh; use en for English-only voices)
# CARTESIA_LANGUAGE=zh

# LAN VoxCPM2-CUDA streaming TTS (`VoxCPM2-CUDA` speech provider).
VOXCPM2_CUDA_BASE_URL=http://192.168.2.128:8765
VOXCPM2_CUDA_SEED=42
VOXCPM2_CUDA_CFG_VALUE=2.0
VOXCPM2_CUDA_INFERENCE_TIMESTEPS=5
VOXCPM2_CUDA_VOICE_DESIGN=一位沉稳的男性，声音清晰自然，音色稳定

# --- Conversation ---
# How a spoken turn is delimited:
#   auto   -- hands-free: voice activity detection starts and ends turns, and
#             speaking over Marcus interrupts him.
#   manual -- the mic button owns turn boundaries (more robust in noisy rooms).
TURN_MODE=auto

# Identify this machine / network in the sidecar's learned routing preferences.
# AGENT_RUNTIME_DEVICE_ID=            # default: the hostname
# AGENT_RUNTIME_NETWORK_ID=default    # e.g. home-wifi, office

# Pipecat small-webrtc transport (browser client signaling)
# Default host/port for the local webrtc signaling server during development.
WEBRTC_HOST=0.0.0.0
WEBRTC_PORT=7860

# --- Engine selection ---
# Which STT/LLM/TTS engine trio to use. One of:
#   auto    (default) -- probe for a working internet connection at startup
#             and use "cloud" if found, "offline" if not (see
#             app/connectivity.py and app/providers/transcription.py's
#             select_engine()).
#   cloud   -- always use the configured cloud providers (the recommended
#             stack above unless model_providers.json selects others).
#   offline -- always use the Pi-portable local fallback (faster-whisper +
#             Ollama + Piper, configured below). No cloud keys needed.
#   omlx    -- always use the Mac-only oMLX dev/test engine (configured
#             below). NOT Pi-portable (Apple Silicon/MLX only) -- for fast
#             local iteration without spending cloud credits or needing
#             network access. No cloud keys needed.
# The legacy FORCE_OFFLINE=true/FORCE_ONLINE=true flags are still honored
# (mapped to ENGINE=offline/ENGINE=cloud) if ENGINE itself is unset.
ENGINE=auto
FORCE_OFFLINE=false
FORCE_ONLINE=false

# Local STT: faster-whisper model size (via Pipecat's WhisperSTTService).
# "small" balances accuracy/speed reasonably for a Raspberry Pi 5; drop to
# "base" or "tiny" for faster/lower-accuracy, or up to "medium" for
# slower/higher-accuracy. See https://github.com/SYSTRAN/faster-whisper for
# the full model list.
WHISPER_MODEL=small

# Local translation: a locally-running Ollama server (OpenAI-compatible API)
# and a small instruct model pulled into it ahead of time, e.g.:
#   ollama pull qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Local TTS: Piper voice model identifier (via Pipecat's PiperTTSService).
# Downloaded automatically into PIPER_DOWNLOAD_DIR on first use if not
# already present there. See https://github.com/OHF-Voice/piper1-gpl for
# the full voice list (pick one matching the language you want spoken).
PIPER_VOICE=en_US-lessac-medium
PIPER_DOWNLOAD_DIR=./models/piper

# --- oMLX (Mac-only dev/test engine, NOT Pi-portable) ---
# A local oMLX server (https://github.com/, OpenAI-API-compatible) running
# on this machine with three models loaded: a chat/LLM model, an STT model,
# and a TTS model. See README.md for setup. oMLX depends on Apple's MLX
# framework, which is Apple-Silicon-only -- this engine exists purely for
# fast local iteration on a Mac dev machine, never for the Raspberry Pi
# deployment target.
OMLX_BASE_URL=http://127.0.0.1:6789/v1
# Local dev-only secret -- put the real value in .env, never commit it.
OMLX_API_KEY=
OMLX_LLM_MODEL=Qwen3.5-4B-MLX-4bit
OMLX_STT_MODEL=nemotron-3.5-asr-streaming-0.6b
OMLX_TTS_MODEL=VoxCPM2-8bit
